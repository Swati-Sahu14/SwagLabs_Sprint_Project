<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="CrossBrowserTesting">

    <!-- Chrome -->
    <test name="Cross Browser Testing in Chrome">
        <parameter name="browser" value="chrome"/>
        <packages>
            <package name="ecomSwagLabsLogin"/>
            <package name="ecomSwagLabsHome"/>
            <package name="ecomSwagLabsCart"/>
            <package name="ecomSwagLabsCheckout"/>
            <package name="ecomSwagLabsDynamicCatalog"/>
        </packages>
    </test>

    <!-- Edge -->
    <test name="Cross Browser Testing in Edge">
        <parameter name="browser" value="edge"/>
        <packages>
            <package name="ecomSwagLabsLogin"/>
            <package name="ecomSwagLabsHome"/>
            <package name="ecomSwagLabsCart"/>
            <package name="ecomSwagLabsCheckout"/>
            <package name="ecomSwagLabsDynamicCatalog"/>
        </packages>
    </test>

    <!-- Firefox -->
    <test name="Cross Browser Testing in firefox">
        <parameter name="browser" value="firefox"/>
        <packages>
            <package name="ecomSwagLabsLogin"/>
            <package name="ecomSwagLabsHome"/>
            <package name="ecomSwagLabsCart"/>
            <package name="ecomSwagLabsCheckout"/>
            <package name="ecomSwagLabsDynamicCatalog"/>
        </packages>
    </test>

</suite>
