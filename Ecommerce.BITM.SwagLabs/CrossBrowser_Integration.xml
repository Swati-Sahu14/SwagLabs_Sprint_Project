<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="CrossBrowser_Integration">

    <test name="Chrome_Integration">
        <parameter name="browser" value="chrome"/>
        <groups>
            <run><include name="integration"/></run>
        </groups>
        <packages>
            <package name="Login_module"/>
            <package name="HomePage_module"/>
            <package name="cart_module_Test"/>
            <package name="Checkout_module_Test"/>
            <package name="DynamicCatalog_module_Test"/>
        </packages>
    </test>

    <test name="Edge_Integration">
        <parameter name="browser" value="edge"/>
        <groups>
            <run><include name="integration"/></run>
        </groups>
        <packages>
            <package name="Login_module"/>
            <package name="HomePage_module"/>
            <package name="cart_module_Test"/>
            <package name="Checkout_module_Test"/>
            <package name="DynamicCatalog_module_Test"/>
        </packages>
    </test>

    <test name="Firefox_Integration">
        <parameter name="browser" value="firefox"/>
        <groups>
            <run><include name="integration"/></run>
        </groups>
        <packages>
            <package name="Login_module"/>
            <package name="HomePage_module"/>
            <package name="cart_module_Test"/>
            <package name="Checkout_module_Test"/>
            <package name="DynamicCatalog_module_Test"/>
        </packages>
    </test>

</suite>
